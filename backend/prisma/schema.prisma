generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Docente {
  id                Int                     @id @default(autoincrement())
  nombre            String
  categoria         Categoria
  antiguedad        Int                     @default(0)
  disponibilidad    String?
  email             String?                 @unique
  password          String?
  resetToken        String?                 @unique
  resetTokenExpiry  DateTime?
  rol               Rol                     @default(DOCENTE)
  dni               String?                 @unique
  fechaContrato     DateTime?
  fechaNombramiento DateTime?
  codigoIBM         String?                 @unique
  condicion         Condicion               @default(ORDINARIO)
  dedicacion        Dedicacion              @default(TC_40H)
  departamento      String                  @default("Departamento de Ingeniería de Sistemas")
  escuela           String                  @default("Ingeniería de Sistemas")
  facultad          String                  @default("Ingeniería")
  sedes             Sede[]                  @default([TRUJILLO])
  cargasNoLectivas  CargaNoLectiva[]
  disponibilidades  DisponibilidadDocente[]
  horarios          Horario[]
  cursos            Curso[]                 @relation("DocenteCursos")
}

model Curso {
  id                      Int              @id @default(autoincrement())
  nombre                  String
  tipo                    TipoCurso        @default(teoria)
  creditos                Int
  ciclo                   Int?
  codigo                  String?          @unique
  horasLaboratorio        Int              @default(0)
  horasPractica           Int              @default(0)
  horasTeoria             Int              @default(0)
  tipoPlan                String           @default("O")
  departamentoResponsable String           @default("INGENIERIA DE SISTEMAS")
  activo                  Boolean          @default(true)
  nivelPlan               String           @default("01 C")
  seccion                 String           @default("U")
  cantidadAlumnos         Int              @default(1)
  lugares                 String[]         @default([])
  seDictaEnFilial         Boolean          @default(false)
  mallaId                 Int?
  malla                   MallaCurricular? @relation(fields: [mallaId], references: [id], onDelete: SetNull)
  horarios                Horario[]
  docentes                Docente[]        @relation("DocenteCursos")

  @@index([ciclo])
  @@index([tipoPlan])
  @@index([mallaId])
}

model MallaCurricular {
  id           Int       @id @default(autoincrement())
  anio         Int
  anioFin      Int
  nombre       String
  facultad     String
  departamento String
  tipoPeriodo  TipoMalla @default(SEMESTRAL)
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cursos       Curso[]

  @@index([anio])
  @@index([anio, departamento])
}

model Aula {
  id        Int       @id @default(autoincrement())
  nombre    String
  tipo      TipoCurso
  capacidad Int
  ubicacion String?   @default("Pabellón de Sistemas")
  horarios  Horario[]
}

model Horario {
  id                 Int           @id @default(autoincrement())
  docenteId          Int
  cursoId            Int?
  aulaId             Int?
  dia                Dia
  horaInicio         DateTime
  horaFin            DateTime
  tipoCurso          TipoCurso?
  grupo              String?
  semestre           String        @default("2026-I")
  actividadNoLectiva String?
  tipoActividad      TipoActividad @default(LECTIVA)
  aula               Aula?         @relation(fields: [aulaId], references: [id])
  curso              Curso?        @relation(fields: [cursoId], references: [id])
  docente            Docente       @relation(fields: [docenteId], references: [id])
}

model ReglaAsignacion {
  id                 Int  @id @default(autoincrement())
  prioridadCategoria Json
  duracionCurso      Int
}

model Notificacion {
  id        Int      @id @default(autoincrement())
  titulo    String
  mensaje   String
  docenteId Int?
  visto     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DisponibilidadDocente {
  id        Int     @id @default(autoincrement())
  docenteId Int
  semestre  String
  bloques   String
  docente   Docente @relation(fields: [docenteId], references: [id], onDelete: Cascade)

  @@unique([docenteId, semestre])
}

model CargaNoLectiva {
  id                      Int     @id @default(autoincrement())
  docenteId               Int
  semestre                String
  preparacionEvaluacion   Int     @default(0)
  consejeria              Int     @default(0)
  investigacion           Int     @default(0)
  capacitacion            Int     @default(0)
  gobierno                Int     @default(0)
  administracion          Int     @default(0)
  asesoriaTesis           Int     @default(0)
  responsabilidadSocial   Int     @default(0)
  comisiones              Int     @default(0)
  otros                   Int     @default(0)
  detallesConsejeria      String?
  detallesInvestigacion   String?
  detallesGobierno        String?
  detallesAdministracion  String?
  detallesAsesoria        String?
  detallesResponsabilidad String?
  detallesComisiones      String?
  docente                 Docente @relation(fields: [docenteId], references: [id])

  @@unique([docenteId, semestre])
}

model SemestreAcademico {
  id          Int                  @id @default(autoincrement())
  codigo      String               @unique
  anio        Int
  ciclo       String
  fechaInicio DateTime             @db.Date
  fechaFin    DateTime             @db.Date
  activo      Boolean              @default(false)
  tipoPeriodo TipoPeriodoAcademico @default(SEMESTRAL)
  facultad    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([activo])
  @@index([anio, ciclo])
}

enum Categoria {
  principal
  asociado
  auxiliar
  jefe_practica
  tipo_a1
  tipo_a2
  tipo_a3
  tipo_b1
  tipo_b2
  tipo_b3
  cesante
  experto
  emerito
  invitado_especial
}

enum Condicion {
  ORDINARIO
  EXTRAORDINARIO
  CONTRATADO
}

enum Dedicacion {
  TC_40H
  DE_EXCLUSIVA
  DOCENTE_INVESTIGADOR
  TP_20H
  TP_4H
  TP_8H
  TP_10H
  TP_12H
  TP_16H
}

enum Sede {
  TRUJILLO
  VALLE_JEQUETEPEQUE
  HUAMACHUCO
  SANTIAGO_DE_CHUCO
}

enum TipoPeriodoAcademico {
  SEMESTRAL
  ANUAL_MEDICINA
  NIVELACION
}

enum TipoMalla {
  SEMESTRAL
  ANUAL
}

enum Rol {
  ADMIN
  DOCENTE
}

enum TipoCurso {
  teoria
  laboratorio
  ambos
}

enum TipoActividad {
  LECTIVA
  NO_LECTIVA
}

enum Dia {
  Lunes
  Martes
  Miercoles
  Jueves
  Viernes
  Sabado
}
