# Runtime serverless: usa el endpoint pooled de Neon (-pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&connect_timeout=15&pool_timeout=15&connection_limit=5"

# Migraciones Prisma: usa el endpoint directo de Neon (sin -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require&connect_timeout=15"

JWT_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
