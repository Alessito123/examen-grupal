{
  "name": "examen-grupal",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación web para la creación de horarios de la Escuela de Ingeniería de Sistemas - Universidad Nacional de Trujillo",
  "main": "index.js",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate --schema=backend/prisma/schema.prisma && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src backend shared scripts tests --ext .ts,.tsx,.js",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"{src,backend,shared,scripts,tests}/**/*.{ts,tsx,js,css}\" \"*.{js,json,md}\"",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand",
    "prisma:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=backend/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=backend/prisma/schema.prisma",
    "import:primer-ciclo": "ts-node scripts/import-primer-ciclo.ts",
    "import:horarios-impares": "ts-node scripts/import-horarios-ciclos-impares.ts",
    "vercel-build": "npm run build",
    "seed": "ts-node scripts/seed.ts",
    "test": "jest --config jest.config.js --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "^5.100.10",
    "@trpc/client": "^11.17.0",
    "@trpc/next": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "next": "^15.5.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.48.0",
    "eslint-config-next": "^15.5.19",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "jest": "^29.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.5.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.0.0"
  },
  "prisma": {
    "seed": "ts-node scripts/seed.ts"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "license": "MIT"
}
