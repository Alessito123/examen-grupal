{
  "name": "examen-grupal",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación web para la creación de horarios de la Escuela de Ingeniería de Sistemas - Universidad Nacional de Trujillo",
  "main": "index.js",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate --schema=backend/prisma/schema.prisma && next build",
    "start": "next start -p 3000",
    "lint": "eslint 'frontend/**/*.{ts,tsx}' 'backend/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'frontend/**/*.{ts,tsx,js,jsx,css}' 'backend/**/*.{ts,tsx,js,jsx,css}'",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "seed": "ts-node scripts/seed.ts",
    "test": "jest --config jest.config.js --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@prisma/client": "^5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-query": "^5.0.0",
    "@trpc/client": "^11.0.0-rc.366",
    "@trpc/next": "^11.0.0-rc.366",
    "@trpc/react-query": "^11.0.0-rc.366",
    "@trpc/server": "^11.0.0-rc.366",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.14",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.0",
    "express": "^4.18.2",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.0",
    "jspdf": "^2.5.1",
    "lucide-react": "^1.16.0",
    "next": "^14.2.35",
    "postcss": "^8.4.24",
    "prisma": "^5.3.0",
    "puppeteer": "^24.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.0",
    "three": "^0.184.0",
    "typescript": "^5.3.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.5.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.3.0",
    "@typescript-eslint/parser": "^6.3.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "jest": "^29.0.0",
    "prettier": "^3.5.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "prisma": {
    "seed": "ts-node scripts/seed.ts"
  },
  "license": "MIT"
}
